{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": false,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": [
    "src/server.ts"
  ],
  "exclude": [
    "src/lib",
    "src/authz-runtime",
    "src/hypercore-runtime",
    "src/components",
    "src/hooks",
    "src/core",
    "node_modules",
    "dist"
  ]
}
