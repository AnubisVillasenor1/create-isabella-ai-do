DATABASE_URL=postgres://ige:change-me@localhost:5432/ige
# Each entry is a unique random bearer token bound to a tenant and user UUID.
# Format: token|tenant_uuid|user_uuid;token2|tenant_uuid|user_uuid
# Generate each token with: openssl rand -hex 32
IGE_API_TOKENS=REPLACE_ME_WITH_OUTPUT_OF_OPENSSL_RAND_HEX_32|00000000-0000-7000-8000-000000000001|00000000-0000-7000-8000-000000000002
RUST_LOG=info
IGE_BIND=0.0.0.0:8080
IGE_RATE_LIMIT_PER_MINUTE=120
