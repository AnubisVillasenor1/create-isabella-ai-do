# Server-side configuration only. Never prefix these secrets with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ISABELLA_OMEGA_API_TOKEN=

# Vercel AI Gateway. On Vercel, AI SDK can use OIDC automatically.
# For local/non-Vercel runtimes, set AI_GATEWAY_API_KEY in your local secret store.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-6.1-sol-fast
# Optional comma-separated model IDs verified in https://ai-gateway.vercel.sh/v1/models
AI_GATEWAY_FALLBACK_MODELS=

# Optional TERMINUS V6 integration.
ISABELLA_TERMINUS_URL=
ISABELLA_TERMINUS_TOKEN=
