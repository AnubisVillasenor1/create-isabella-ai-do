# Server-side secrets only. Never use NEXT_PUBLIC_ prefixes for credentials.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ISABELLA_OMEGA_API_TOKEN=

# Optional TERMINUS V6 integration.
ISABELLA_TERMINUS_URL=
ISABELLA_TERMINUS_TOKEN=

# Vercel AI Gateway (AI SDK may use Vercel OIDC in supported deployments).
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-6.1-sol-fast
AI_GATEWAY_FALLBACK_MODELS=

# Hugging Face Inference Providers. Create a token in Hugging Face settings.
# Usage is subject to account credits, provider availability, rate limits and model licenses.
HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b:fireworks-ai

# Optional local/self-hosted Ollama runtime. In production, use a reachable private endpoint.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
