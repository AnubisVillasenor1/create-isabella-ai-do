# Isabella Villaseñor AI — environment contract
# Copy to .env.development.local or .env and replace every <...> value.
# Never commit real credentials. Public browser variables must use NEXT_PUBLIC_.

# Runtime and application
NODE_ENV=development
VITEST=false
HOST=0.0.0.0
PORT=8080
APP_PUBLIC_URL=http://localhost:8080
PUBLIC_URL=http://localhost:8080
ISABELLA_PUBLIC_URL=http://localhost:8080
VERCEL=false
VERCEL_OIDC_TOKEN=
TRUST_PROXY=false
STRICT_PREFLIGHT=true
# Techo por defecto de peticiones mutantes (POST/PUT/PATCH/DELETE) por IP y minuto en /api.
# 1..100000; cualquier otro valor cae en 300. No sustituye a los límites específicos de ruta.
API_DEFAULT_RATE_LIMIT_PER_MIN=300
# Comma-separated exact origins allowed for CORS (e.g. https://app.example.mx). Never wildcard in production.
ALLOWED_ORIGINS=http://localhost:8080
RUNTIME_SMOKE=0
CROWN_CONSTITUTION_VERSION=RC-0.1a
ISABELLA_BOT_NAME=Isabella
ISABELLA_BOT_VERSION=1.0.0
ISABELLA_LANGUAGE=es
ISABELLA_MAX_RESPONSE_LENGTH=4096
LLM_DEFAULT_MODEL=google/gemini-flash-1.5
MODEL_API_KEY=

# Primary PostgreSQL / Prisma
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
POSTGRES_URL=postgresql://<user>:<password>@<host>:5432/<database>
POSTGRES_URL_NON_POOLING=postgresql://<user>:<password>@<host>:5432/<database>
POSTGRES_PRISMA_URL=postgresql://<user>:<password>@<host>:5432/<database>
POSTGRES_HOST=
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=

# BookPI and ledger
BOOKPI_PIPELINE_STORAGE=postgres
BOOKPI_INTEGRITY_SECRET=<generate-with-openssl-rand-base64-32>
BOOKPI_SIGNATURE_ALGORITHM=ML-DSA-65
BOOKPI_LEDGER_PATH=/var/lib/bookpi/ledger
BOOKPI_PIPELINE_LEDGER_PATH=/var/lib/bookpi/ledger
GENESIS_DOCUMENT_SEAL_KEY_PEM=
GAMEOVER_PASSPORT_PATH=
# Ed25519 pair behind /api/isabella/crypto/sign (and the default key for /verify).
# Optional: when either value is empty the server generates an ephemeral pair at boot, so
# signatures are valid only for that process and cannot be re-verified after a restart.
ISABELLA_SIGNING_PRIVATE_KEY_PEM=
ISABELLA_SIGNING_PUBLIC_KEY_PEM=

# IVCC · Cognitive Voice Operating System
# Durable store for consent, voice profiles, prosody memory and the hash-chained audit.
# Required in production for mutations and synthesis; without it the runtime is ephemeral.
IVCC_DATA_DIR=/var/lib/isabella/ivcc
# Optional explicit secret material (>=16 chars). If omitted, 0600 files are generated
# inside IVCC_DATA_DIR; without a data directory the values are ephemeral per process.
IVCC_SUBJECT_SALT=<generate-with-openssl-rand-base64-32>
IVCC_WATERMARK_SECRET=<generate-with-openssl-rand-base64-32>

# Operational authentication and approvals
# Stable server-side principal ID of the creator's authenticated human account (not a display name or alias).
# Set this to the actual verified principal ID from your auth provider; never use a value supplied by the browser.
ISABELLA_CREATOR_PRINCIPAL_ID=
GENESIS_ADMIN_API_TOKEN=<generate-with-openssl-rand-base64-32>
OPS_API_TOKEN=<generate-with-openssl-rand-base64-32>
HSF_API_TOKEN=<generate-with-openssl-rand-base64-32>
GENESIS_PUBLIC_API_TOKEN=<generate-with-openssl-rand-base64-32>
GENESIS_HUMAN_APPROVAL_TOKEN=<generate-with-openssl-rand-base64-32>
GENESIS_HUMAN_APPROVER_ID=human-approver-001
# Bearer token required by the inbound MCP JSON-RPC endpoint (POST /api/mcp).
# Fail-closed: with no value configured the endpoint answers 503 and never runs a tool.
MCP_SERVER_TOKEN=
# Native program/API-key registry. Only SHA-256 (or HMAC with the pepper) digests
# are persisted; the secret is shown once. Use "memory" on ephemeral deployments
# unless a durable database is wired. The JSON backend is local/operator-friendly.
ISABELLA_API_KEY_STORE=file
ISABELLA_API_KEY_STORE_PATH=.data/api-keys.json
ISABELLA_API_KEY_PEPPER=
# Native federation: signed webhook ingress + normalized inbox + API/model catalog.
# ISABELLA_FEDERATION_SECRET must be at least 32 chars (HMAC-SHA256).
# ISABELLA_FEDERATION_VERIFY_TOKEN powers the hub.challenge handshake (>= 16 chars).
# "memory" is local development only. Serverless production needs a shared durable adapter.
ISABELLA_FEDERATION_STORE=file
ISABELLA_FEDERATION_STORE_PATH=.data/federation.json
ISABELLA_FEDERATION_SECRET=
ISABELLA_FEDERATION_VERIFY_TOKEN=
ISABELLA_APPROVAL_PRIVATE_KEY_PEM="<ed25519-private-key-with-\\n-escapes>"
ISABELLA_APPROVAL_TRUSTED_PUBLIC_KEY_PEM="<ed25519-public-key-with-\\n-escapes>"
ISABELLA_APPROVAL_KEY_ID=key-1
ISABELLA_APPROVAL_TRUSTED_KEY_ID=key-1
ISABELLA_APPROVAL_TRUSTED_APPROVER_ID=human-approver-001

# WebAuthn trust anchors (required when a WebAuthn credential is enrolled; assertions fail closed without them)
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# AI providers (configure at least one provider)
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=openrouter/free
OPENAI_COMPAT_API_TOKEN=
OPENAI_COMPAT_MODEL_ID=google/gemini-flash-1.5
# Multi-provider gateway activity ledger (in-process, redacted previews only).
GATEWAY_AUDIT_MAX_ENTRIES=500
GATEWAY_AUDIT_SALT=isabella-gateway
HF_TOKEN=
HF_FREE_MODELS=meta-llama/Llama-3.2-3B-Instruct,google/gemma-2-2b-it
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_TTS_MODEL=playai-tts
# Canonical female voice: only known female PlayAI voices are accepted; any other
# value falls back to Celeste-PlayAI. Request bodies can never override it.
GROQ_TTS_VOICE=Celeste-PlayAI
# Voice id expected by an operator-owned native neural service (must render the
# same female es-MX identity). Public callers cannot change it.
ISABELLA_NATIVE_VOICE_ID=isabella-esmx-v1
# Keyless external neural voice fallback. Explicit operator opt-in: spoken text
# leaves the node to this provider. The browser SpeechSynthesis remains the
# client-side fallback when this is disabled or unreachable.
ISABELLA_KEYLESS_TTS=google
ISABELLA_KEYLESS_TTS_MAX_CHARS=1200
# Local Ollama inference (optional, private). Off unless OLLAMA_ENABLED=true.
# When enabled it powers the explicit "sovereign" engine; the "auto" engine uses free external providers.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.3:8b
OLLAMA_TIMEOUT_MS=45000
# Only set true to reach a non-loopback/non-private Ollama host on a trusted network.
OLLAMA_ALLOW_REMOTE=false
# Private local OpenAI-compatible model server (llama.cpp / vLLM / LM Studio serving a
# Qwen-class model). Off unless ISABELLA_LOCAL_COMPAT_ENABLED=true. Loopback/private only
# unless ISABELLA_LOCAL_COMPAT_ALLOW_REMOTE=true on a trusted network. The base URL must
# already include the version path (e.g. http://127.0.0.1:8089/v1); /chat/completions is
# appended. Disclosed as "local-compatible"; never presented as sovereign inference.
ISABELLA_LOCAL_COMPAT_ENABLED=false
ISABELLA_LOCAL_COMPAT_BASE_URL=http://127.0.0.1:8089/v1
ISABELLA_LOCAL_COMPAT_MODEL=qwen2.5-7b-instruct
ISABELLA_LOCAL_COMPAT_API_KEY=
ISABELLA_LOCAL_COMPAT_ALLOW_REMOTE=false
ISABELLA_LOCAL_COMPAT_TIMEOUT_MS=45000
HYPERCORE_API_TOKEN=
HYPERCORE_SIGNING_KEY=
GRATIS_API_KEY=
GRATIS_API_MODEL=
GRATIS_API_URL=
# Keyless external providers: explicit operator opt-in (off when unset).
# Comma-separated order. Each sends prompts and bounded history to that third party;
# responses stay disclosed as "keyless-free".
ISABELLA_KEYLESS_FREE_PROVIDER=llm7,pollinations
KEYLESS_FREE_PROVIDER_URL=https://text.pollinations.ai
KEYLESS_FREE_PROVIDER_MODEL=openai
KEYLESS_FREE_PROVIDER_TIMEOUT_MS=30000
# Optional free-tier key. Raises per-IP reply limits; never exposed by any endpoint.
KEYLESS_FREE_PROVIDER_KEY=
# Window used when the free tier reports quota exhaustion (HTTP 402/429).
KEYLESS_FREE_QUOTA_COOLDOWN_MS=30000
# OpenAI-compatible free route (open-weight models). Auth optional.
LLM7_BASE_URL=https://api.llm7.io
LLM7_MODEL=gpt-oss:20b
LLM7_API_KEY=
AI_GATEWAY_API_KEY=

# Multimodal providers
STEP_API_KEY=
STEPFUN_API_KEY=
WAN_GRADIO_URL=
INFERENCE_TIMEOUT_MS=30000
MULTIMODAL_TIMEOUT_MS=60000

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Premium defaults to US$20 reference + 25% markup = US$25/month.
ISABELLA_REFERENCE_AI_PRICE_CENTS=2000
ISABELLA_PRICE_MARKUP_BPS=2500
# Optional Stripe Price IDs; premium must match the calculated price exactly.
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_VIP=
STRIPE_PRICE_ENTERPRISE=
# Granular Stripe Price IDs consumed by the commerce catalog (src/commerce/pricing.ts).
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_VIP_MONTHLY=
STRIPE_PRICE_VIP_YEARLY=
CONNECTOR_PROVIDERS=
CONNECTOR_TENANT_MAP=
CONNECTOR_WEBHOOK_SECRET=

# Supabase (optional alternative / integrations)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# Optional data services
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
QDRANT_URL=
QDRANT_API_KEY=
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=isabella-artifacts
MONGODB_URI=

# Quantum and native gateways
PENNYLANE_DEVICE=lightning.qubit
PENNYLANE_SHOTS=1000
PENNYLANE_BRIDGE_TIMEOUT_MS=30000
PENNYLANE_BRIDGE_URL=
PENNYLANE_BACKEND=
IGE_OMEGA_ENDPOINT=http://localhost:8080

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics

# Session, chat, and reconciliation
CHAT_CHAIN_BUDGET_MS=45000
CHAT_HEDGE_DELAY_MS=500
# Input-token ceiling for compressed provider history (512..32000)
CHAT_CONTEXT_MAX_INPUT_TOKENS=3000
SESSION_MEMORY_MAX_MESSAGES=100
SESSION_MEMORY_MAX_SESSIONS=1000
RECONCILIATION_MAX_ATTEMPTS=3
RECONCILIATION_RETRY_BASE_MS=1000
RECONCILIATION_RETRY_MAX_MS=10000
RECONCILIATION_TIMEOUT_MS=30000

# Feature flags and provider resilience
ALLOW_PAID_PROVIDER_FALLBACK=false
PROVIDER_FAILURE_COOLDOWN_MS=30000

# Provenance identifiers
ORCID_ID=
ZENODO_DOI=
DATACITE_DOI=
ISNI=
PID_NAMESPACE=tamv
PID_STRICT=false

# External tooling / deployment
OTEL_SERVICE_NAME=isabella-genesisai
NPM_TOKEN=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_TOKEN_ID_2=
MUX_TOKEN_SECRET_2=
STRIPE_MCP_KEY=

# state: draft | engine-generated — modelo opcional del gateway DeepSeek existente.
DEEPSEEK_APIKEY=
DEEPSEEK_MODEL=deepseek-chat

# Modo Terminus Blackout. El emisor es el segmento tras ISA_KILL_PUBKEY_: cada valor es una
# clave pública Ed25519 en SPKI-DER base64. Sin ninguna clave autorizada, toda orden
# ENGAGE/RELEASE se rechaza ("issuer not authorized"): la superficie queda montada pero inerte.
# ISA_KILL_PUBKEY_CROWN=
# ISA_KILL_PUBKEY_TESORERO=
# Halt de entorno no levantable por firma: 1|true|yes apaga GLOBAL hasta que se retira.
ISA_KILL_SWITCH=
# Vigencia máxima de un halt sin renovación (ms). Por defecto 1 hora.
ISA_KILL_MAX_DURATION_MS=3600000

# --- Script, CI and optional providers (manual) ---
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=
FIREWORKS_API_KEY=
FIREWORKS_MODEL=
TOGETHER_API_KEY=
TOGETHER_MODEL=
PERPLEXITY_API_KEY=
PERPLEXITY_ROUTER_MODEL=
GROQ_MODEL=
HYPERCORE_API_KEY=
HYPERCORE_LOG_EVENTS=false
BOOKPI_ACTOR_ID=
ATLAS_READ_TOKEN=
APP_BASE_URL=
OLLAMA_API_KEY=
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPOSITORY=
GITHUB_REF_NAME=
GITHUB_SHA=
EXPECTED_SHA=
THE_SHA=
MAX_REPOS=100
INCLUDE_FORKS=false
RUNNER_TEMP=
TEMP=
SMOKE_BASE_URL=
ISABELLA_REQUIRE_LLM_SMOKE=false

HF_INFERENCE_URL=https://router.huggingface.co/hf-inference/models

